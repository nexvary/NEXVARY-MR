{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NEXVARY Device Research Compatibility Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "vendor",
    "model",
    "platform",
    "os_build",
    "security_patch",
    "capability",
    "status",
    "source_ids",
    "last_reviewed"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "vendor": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "platform": {
      "enum": [
        "android",
        "ios",
        "other"
      ]
    },
    "os_build": {
      "type": "string",
      "minLength": 1
    },
    "security_patch": {
      "type": "string",
      "minLength": 1
    },
    "capability": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "VERIFIED",
        "REPORTED",
        "HYPOTHESIS",
        "REFUTED"
      ]
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "last_reviewed": {
      "type": "string",
      "format": "date"
    },
    "test_report": {
      "type": "string"
    },
    "limitations": {
      "type": "string"
    }
  }
}
