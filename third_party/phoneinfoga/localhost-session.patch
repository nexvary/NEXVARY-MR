+// NEXVARY modification: localhost session authentication before route handlers.
+func nexvarySession(token string) gin.HandlerFunc {
+ return func(c *gin.Context) {
+  if c.GetHeader("Origin") != "" { c.AbortWithStatus(403); return }
+  if c.Request.Method == "GET" && c.Request.URL.Path == "/api/" {
+   challenge := c.GetHeader("X-Nexvary-Challenge")
+   if len(challenge) != 32 { c.AbortWithStatus(403); return }
+   mac := hmac.New(sha256.New, []byte(token)); mac.Write([]byte(challenge))
+   c.Header("X-Nexvary-Proof", hex.EncodeToString(mac.Sum(nil)))
+   c.JSON(200, gin.H{"engine":"nexvary-phoneinfoga-session/v1"}); c.Abort(); return
+  }
+  if !hmac.Equal([]byte(c.GetHeader("Authorization")), []byte("Bearer " + token)) { c.AbortWithStatus(403); return }
+  allowed := c.Request.Method == "GET" && c.Request.URL.Path == "/api/v2/scanners"
+  for _, scanner := range []string{"local","googlesearch","ovh","numverify","googlecse"} {
+   if c.Request.Method == "POST" && c.Request.URL.Path == "/api/v2/scanners/"+scanner+"/run" { allowed = true }
+  }
+  if !allowed { c.AbortWithStatus(404); return }
+  c.Request.Body = http.MaxBytesReader(c.Writer,c.Request.Body,4096)
+  c.Next()
+ }
+}
