{
  "$schema": "https://opencode.ai/config.json",

  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "todowrite": "allow",
    "webfetch": "allow",
    "task": "allow",
    "skill": "allow",
    "question": "allow",

    "edit": {
      "*": "ask",
      "/tmp/opencode/**": "allow",
      "./**": "allow"
    },

    "bash": {
      "*": "ask",

      "ls": "allow",
      "ls *": "allow",
      "echo *": "allow",
      "mkdir -p *": "allow",
      "cp *": "allow",
      "python3 *": "allow",
      "python *": "allow",
      "pytest *": "allow",
      "pytest": "allow",
      "cmake *": "allow",
      "ctest *": "allow",
      "ctest": "allow",
      "ninja *": "allow",
      "ninja": "allow",
      "make *": "allow",
      "make": "allow",

      "git status": "allow",
      "git status *": "allow",
      "git branch": "allow",
      "git branch *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git show *": "allow",
      "git fetch": "allow",
      "git fetch *": "allow",
      "git stash": "allow",
      "git stash *": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "git checkout -b *": "allow",
      "git checkout feat/*": "allow",
      "git checkout docs/*": "allow",
      "git merge --ff-only *": "allow",
      "git push origin feat/*": "allow",
      "git push origin docs/*": "allow",
      "git push --set-upstream origin feat/*": "allow",
      "git push --set-upstream origin docs/*": "allow",
      "git push -u origin feat/*": "allow",
      "git push -u origin docs/*": "allow",

      "sudo *": "deny",
      "su *": "deny",
      "aws *": "deny",
      "gh auth*": "deny",
      "chmod 777*": "deny",
      "chown *": "deny",
      "curl *169.254.169.254*": "deny",
      "wget *169.254.169.254*": "deny",
      "curl *amazonaws.com/latest/meta-data*": "deny",
      "cat ~/.aws*": "deny",
      "cat ~/.ssh*": "deny",
      "cat /etc/shadow*": "deny",
      "cat *id_rsa*": "deny",
      "cat *credentials*": "deny",
      "rm -rf /*": "deny",
      "rm -rf ~*": "deny",
      "rm -rf /home/*": "deny",
      "rm -f ~/.aws*": "deny",
      "rm -f ~/.ssh*": "deny",
      "rm -f /etc*": "deny",
      "rm -f /usr*": "deny",
      "git push origin main": "deny",
      "git push origin main *": "deny",
      "git push --force*": "deny",
      "git push -f *": "deny",
      "git push -f": "deny",
      "git merge main": "deny",
      "git merge main *": "deny",
      "git rebase main": "deny",
      "git rebase main *": "deny"
    },

    "external_directory": {
      "*": "deny",
      "/tmp/opencode/**": "allow",
      "./**": "allow",
      "~/.aws/**": "deny",
      "~/.ssh/**": "deny",
      "~/.config/opencode/**": "deny"
    }
  }
}
