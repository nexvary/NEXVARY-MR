{
  "$schema": "https://opencode.ai/config.json",

  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "todowrite": "allow",
    "webfetch": "allow",
    "task": "allow",
    "skill": "allow",

    "edit": {
      "/home/ubuntu/nexvary/projects/NEXVARY-MR/**": "allow",
      "/tmp/opencode/**": "allow",
      "*": "ask"
    },

    "bash": {
      "git status": "allow",
      "git status *": "allow",
      "git branch": "allow",
      "git branch *": "allow",
      "git log *": "allow",
      "git log": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git show *": "allow",
      "git fetch *": "allow",
      "git fetch": "allow",
      "git checkout -b *": "allow",
      "git checkout feat/*": "allow",
      "git checkout docs/*": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "git stash": "allow",
      "git stash *": "allow",
      "git push origin feat/*": "allow",
      "git push origin docs/*": "allow",
      "git push --set-upstream origin feat/*": "allow",
      "git push --set-upstream origin docs/*": "allow",
      "git push -u origin feat/*": "allow",
      "git push -u origin docs/*": "allow",
      "git merge --ff-only *": "allow",
      "git merge --no-ff *": "ask",
      "git push origin main*": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git merge main*": "deny",
      "git rebase main*": "ask",
      "git reset --hard*": "ask",
      "git clean -f*": "ask",

      "cmake *": "allow",
      "ctest *": "allow",
      "ctest": "allow",
      "ninja *": "allow",
      "ninja": "allow",
      "make *": "allow",
      "make": "allow",
      "python3 *": "allow",
      "python *": "allow",
      "pytest *": "allow",
      "pytest": "allow",

      "ls *": "allow",
      "ls": "allow",
      "echo *": "allow",
      "mkdir -p *": "allow",
      "cp *": "allow",
      "mv *": "ask",

      "rm -rf /*": "deny",
      "rm -rf ~*": "deny",
      "rm -f /etc*": "deny",
      "rm -f /usr*": "deny",
      "rm -f /home/ubuntu/.aws*": "deny",
      "rm -f /home/ubuntu/.ssh*": "deny",
      "rm -f /home/ubuntu/.config/opencode*": "deny",
      "rm *": "ask",
      "rm -rf *": "ask",

      "cat /home/ubuntu/.aws*": "deny",
      "cat /home/ubuntu/.ssh*": "deny",
      "cat /etc/passwd*": "deny",
      "cat /etc/shadow*": "deny",
      "cat *id_rsa*": "deny",
      "cat *credentials*": "deny",

      "curl *amazonaws.com*": "deny",
      "curl *169.254.169.254*": "deny",
      "wget *169.254.169.254*": "deny",

      "sudo *": "deny",
      "su *": "deny",
      "chmod 777*": "deny",
      "chown *": "deny",

      "aws *": "deny",
      "gh auth*": "deny",

      "*": "ask"
    },

    "external_directory": {
      "/home/ubuntu/nexvary/projects/NEXVARY-MR/**": "allow",
      "/home/ubuntu/nexvary/projects/NEXVARY-MR/.opencode/**": "allow",
      "/tmp/opencode/**": "allow",
      "/home/ubuntu/.aws/**": "deny",
      "/home/ubuntu/.ssh/**": "deny",
      "/home/ubuntu/.config/opencode/**": "deny",
      "*": "deny"
    }
  }
}
